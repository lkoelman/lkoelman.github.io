---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const groupedPosts = posts.reduce<Record<string, typeof posts>>((acc, post) => {
	const year = String(post.data.pubDate.getFullYear());
	acc[year] ??= [];
	acc[year].push(post);
	return acc;
}, {});

const postsByYear = Object.entries(groupedPosts).sort(
	([yearA], [yearB]) => Number(yearB) - Number(yearA),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="archive-intro">
				<p class="eyebrow">Archive</p>
				<h2>Writing, musing, and shipping.</h2>
				<p>
					A chronological archive in the spirit of the reference layout, rebuilt for this Astro site with
					a darker editor-like palette and simpler post presentation.
				</p>
			</section>

			<nav class="year-nav" aria-label="Jump to year">
				{
					postsByYear.map(([year]) => (
						<a href={`#year-${year}`}>{year}</a>
					))
				}
			</nav>

			<section class="archive">
				{
					postsByYear.map(([year, yearPosts]) => (
						<section class="year-group" aria-labelledby={`year-${year}`}>
							<h2 id={`year-${year}`}>{year}</h2>
							<ul class="archive-list">
								{yearPosts.map((post) => (
									<li>
										<a href={`/blog/${post.id}/`} class="archive-link">
											<span class="post-name">{post.data.title}</span>
											<span class="post-date">{post.data.pubDate.toLocaleDateString('en-US', {
												month: 'short',
												day: 'numeric',
												year: 'numeric',
											})}</span>
										</a>
										<p>{post.data.description}</p>
									</li>
								))}
							</ul>
						</section>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	.archive-intro {
		margin-bottom: 2rem;
	}
	.year-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 0.9rem;
		margin: 0 0 2rem;
		padding-bottom: 2rem;
		border-bottom: 1px solid var(--border);
	}
	.year-nav a {
		font-family:
			"SFMono-Regular", SFMono-Regular, ui-monospace, Menlo, Monaco, Consolas, "Liberation Mono",
			"Courier New", monospace;
		font-size: 0.9rem;
	}
	.year-group {
		margin-bottom: 3rem;
	}
	.archive-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.archive-list li {
		padding: 0.85rem 0 1.15rem;
		border-top: 1px solid var(--border);
	}
	.archive-list li:last-child {
		border-bottom: 1px solid var(--border);
	}
	.archive-link {
		display: flex;
		gap: 1rem;
		align-items: baseline;
		justify-content: space-between;
		text-decoration: none;
	}
	.post-name {
		color: var(--heading);
		font-family:
			"SFMono-Regular", SFMono-Regular, ui-monospace, Menlo, Monaco, Consolas, "Liberation Mono",
			"Courier New", monospace;
		font-size: 1rem;
	}
	.post-date {
		flex-shrink: 0;
		color: var(--date);
		font-family:
			"SFMono-Regular", SFMono-Regular, ui-monospace, Menlo, Monaco, Consolas, "Liberation Mono",
			"Courier New", monospace;
		font-size: 0.82rem;
	}
	.archive-list p {
		margin: 0.35rem 0 0;
		color: var(--text-muted);
	}
	@media (max-width: 720px) {
		.archive-link {
			display: block;
		}
		.post-date {
			display: block;
			margin-top: 0.25rem;
		}
	}
</style>
